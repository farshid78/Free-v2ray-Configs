# ─────────────────────────────────────────────────────────────────────────────
# نمونهٔ تنظیماتِ ربات تلگرام.  کپی کنید:  cp .env.example .env
# فایلِ `.env` واقعی هرگز کامیت نمی‌شود (.gitignore) و توکن نباید هیچ‌جا منتشر شود.
# ─────────────────────────────────────────────────────────────────────────────

# توکنِ ربات — از @BotFather → /newbot (یا /mybots) گرفته می‌شود.
# با خالی‌بودنش، `python -m bot.main` با پیام «BOT_TOKEN is not set» می‌ایستد.
BOT_TOKEN=

# آیدیِ عددیِ خودتان — از @userinfobot. با این مقدار دکمهٔ «🛡️ پنل ادمین»
# در منوی /start ظاهر می‌شود. اگر 0/خالی باشد، هیچ‌کس ادمین نیست.
OWNER_ID=

# هندلِ کانال — فقط برای نمایش/لینک‌ها. ربات امروز در کانال پست نمی‌کند.
CHANNEL_USERNAME=jojo_config

# فقط برای دکمهٔ «🔄 Trigger aggregate» لازم است:
# GitHub → Settings → Developer settings → Personal access tokens → Fine-grained
# با دسترسیِ Actions: write (یا کلاسیک با scope `repo`/`workflow`).
# خالی‌بودنش فقط همان یک دکمه را از کار می‌اندازد، نه ربات را.
GITHUB_TOKEN=

GH_OWNER=farshid78
GH_REPO=Free-v2ray-Configs

# آدرسِ «پنل گلس» (Mini App). تلگرام فقط HTTPS را قبول می‌کند.
# پیش‌فرض به GitHub Pages اشاره می‌کند؛ تا وقتی Pages در
# Settings → Pages → Source: Deploy from a branch → main /docs فعال نشود،
# این صفحه 404 می‌دهد (دکمه نمایش داده می‌شود ولی صفحه باز نمی‌شود).
MINI_APP_URL=https://farshid78.github.io/Free-v2ray-Configs/miniapp.html

# محلِ دیتابیسِ SQLite ربات (کاربران/ادمین‌ها). مسیر نسبی = نسبت به ریشهٔ مخزن.
BOT_DB=data/bot.db

# پروکسی (اختیاری) — اگر شبکه‌تان به api.telegram.org نمی‌رسد:
# HTTPS_PROXY=http://127.0.0.1:2080
