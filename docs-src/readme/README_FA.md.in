{{raw}}/fast/singbox.json

# ── secure — verified و دارای forward secrecy ──────────────────────────────────
{{raw}}/secure/configs.txt
{{raw}}/secure/configs_base64.txt
{{raw}}/secure/clash.yaml
{{raw}}/secure/singbox.json

# ── google — verified و دسترسی به سرویس‌های گوگل + Gemini (gstatic · YouTube · Play · Maven · Gemini) ──
{{raw}}/google/configs.txt
