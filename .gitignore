# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editors
.DS_Store
*.swp

# Local test output (never commit secrets/env)
.env
.env.*
*.env
# …but the template itself is safe and the setup docs tell users to copy it.
!.env.example
*.local

# CI validation report (artifact only — never committed)
validation.json

# پایگاهِ دادهٔ GeoIP — ۸ مگابایت، ماهانه عوض می‌شود، و در CI دانلود/cache
# می‌شود. اگر commit شود، هر اجرا یک نسخهٔ ۸ مگابایتیِ تازه به تاریخِ مخزن
# اضافه می‌کند؛ یعنی همان الگوی رشدی که فازِ پیشین آن را متوقف کرد.
.cache/

# وضعیتِ رانتایمِ انتشار خودکار (offset/فاصله) — نه سورس
data/auto_publish_state.json

# وضعیتِ رانتایم (status/lock/heartbeat) — منبعِ حقیقت محلی؛ نسخهٔ منتشرشده روی شاخهٔ state است
data/runtime/
# صف و دفترِ ارسال (SQLite، فقط رانتایم)
data/outbox.db
data/outbox.db-wal
data/outbox.db-shm
# پایگاهِ دادهٔ ربات تلگرام (SQLite) — رانتایم، نباید commit شود
data/bot.db
data/bot.db-wal
data/bot.db-shm

# گراف کد (تولیدشده توسط graphify) — نگه‌داری محلی، main را lean نگه می‌دارد
graphify-out/
